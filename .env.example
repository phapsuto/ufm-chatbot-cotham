# ═══ FPT Cloud (PRIMARY — Chat LLM) ═══
FPT_CLOUD_API_KEY=your-api-key-here
FPT_CLOUD_BASE_URL=https://mkp-api.fptcloud.com/v1
FPT_CLOUD_DEFAULT_MODEL=gemma-4-31B-it

# ═══ Gemini API (Google Search Grounding only) ═══
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_DEFAULT_MODEL=gemini-flash-latest

# ═══ LLM Settings ═══
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_STREAM=true

# ═══ Cache ═══
CACHE_TTL_HTML=900
CACHE_TTL_PDF=43200
CACHE_MAX_SIZE=100

# ═══ App ═══
DEBUG_MODE=false
PORT=8000
ALLOWED_DOMAIN=daotaosdh.ufm.edu.vn

# ═══ Tesseract OCR (optional — scanned PDFs need this) ═══
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
TESSERACT_LANG=vie+eng
OCR_DPI=300
OCR_MIN_TEXT_LENGTH=100
MAX_PDF_SIZE_MB=25

# ═══ CRM Dashboard ═══
CRM_DASHBOARD_PASSWORD=ufm_crm_2026
CRM_SESSION_SECRET=your-secret-key-here

# ═══ TTS (VieNeu-TTS Sidecar) ═══
TTS_BASE_URL=http://localhost:23333
TTS_TIMEOUT=30.0
